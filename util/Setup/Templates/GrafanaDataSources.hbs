# config file version
apiVersion: 1

# list of datasources to insert/update depending
# what's available in the database
# see: https://grafana.com/docs/grafana/latest/datasources/mssql/
datasources:
- name: MSSQL
  # <string, required> datasource type. Required
  type: mssql
  # <string, required> access mode. proxy or direct (Server or Browser in the UI). Required
  access: proxy
  # <int> org id. will default to orgId 1 if not specified
  orgId: 1
  # <string> url ex set to localhost:1433
  url: $BSAFE_DB_URL
  user: $globalSettings__grafana__dBUser
  jsonData:
      database: $BSAFE_DB_NAME
      encrypt: 'false'
  isDefault: true
  version: 1
  # <bool> allow users to edit datasources from the UI.
  editable: true

  secureJsonData:
    password : '$globalSettings__grafana__dBUserPassword'
  