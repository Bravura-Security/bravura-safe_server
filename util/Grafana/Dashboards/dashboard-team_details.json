          "rawSql": "SELECT CAST( EventView.Date AS DATE) AS \"time\", EventType.event \"Event\", COUNT(*)\r\nFROM EventView \r\nJOIN OrganizationView ON OrganizationView.Id = EventView.OrganizationId\r\nJOIN metadata.EventType ON EventView.Type = EventType.code \r\nWHERE OrganizationView.Name = '$OrganizationName'\r\nGROUP BY CAST( EventView.Date AS DATE), \"Event\"\r\nORDER BY CAST( EventView.Date AS DATE) ASC\r\n;",
